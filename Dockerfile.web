# Vercel container service "web". Lives at the repo root because Vercel builds from the Dockerfile's folder.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/types/package.json packages/types/
COPY packages/api-client/package.json packages/api-client/
COPY packages/core/package.json packages/core/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @tc/web...
COPY packages packages
COPY apps/web apps/web
RUN pnpm --filter @tc/web... --filter=!@tc/web build && pnpm --filter @tc/web exec vite build

FROM nginx:1.27-alpine
ENV PORT=80
COPY apps/web/deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY apps/web/deploy/40-write-env.sh /docker-entrypoint.d/40-write-env.sh
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 80
