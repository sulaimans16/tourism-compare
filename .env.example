# ---------- Shared ----------
# Supabase project "tourism-compare". URL and publishable key are public values.
SUPABASE_URL=https://eezpbtvydnxcavsmxiux.supabase.co
SUPABASE_ANON_KEY=sb_publishable_IPb_Gs7DTPWj-v8-cs_pVQ_SpvrN7c7
# Secret: Dashboard -> Project Settings -> API Keys -> service_role / secret key. Never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Secrets normally loaded from Supabase Vault ----------
# node-api and java-pricing read SERPAPI_API_KEY, GOOGLE_MAPS_API_KEY, PRICING_SERVICE_TOKEN and
# REDIRECT_SIGNING_SECRET from Vault (Dashboard -> Database -> Vault) at startup using the service role key.
# Setting any of them here overrides Vault. PRICING_SERVICE_TOKEN/REDIRECT_SIGNING_SECRET are already generated in Vault.

# ---------- services/node-api ----------
PORT=8080
CORS_ORIGINS=http://localhost:5173
# SERVER key (no HTTP-referrer restriction) with "Places API (New)" + "Routes API". Prefer Vault.
# GOOGLE_MAPS_API_KEY=
# Where java-pricing runs: localhost locally, http://java-pricing:8090 in docker compose, private URL on Render.
PRICING_SERVICE_URL=http://localhost:8090
# PRICING_SERVICE_TOKEN=   # generated in Vault; only set to override
REDIS_URL=redis://localhost:6379

# ---------- services/java-pricing ----------
# https://serpapi.com/manage-api-key. Prefer Vault.
# SERPAPI_API_KEY=
PRICING_PORT=8090

# ---------- apps/web ----------
VITE_API_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=https://eezpbtvydnxcavsmxiux.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_IPb_Gs7DTPWj-v8-cs_pVQ_SpvrN7c7
# BROWSER key for Maps JavaScript API + Places API (New), restricted by HTTP referrer
# (http://localhost:5173/* and your production domain). Optional: maps are hidden without it.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Map ID from Google Cloud -> Map Management (needed for Advanced Markers in production).
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# ---------- apps/mobile ----------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_SUPABASE_URL=https://eezpbtvydnxcavsmxiux.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_IPb_Gs7DTPWj-v8-cs_pVQ_SpvrN7c7
