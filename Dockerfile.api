# Vercel container service "api". Lives at the repo root because Vercel builds from the Dockerfile's folder.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/types/package.json packages/types/
COPY services/node-api/package.json services/node-api/
RUN pnpm install --frozen-lockfile --filter @tc/node-api...
COPY packages/types packages/types
COPY services/node-api services/node-api
RUN pnpm --filter @tc/types build && pnpm --filter @tc/node-api build
RUN pnpm deploy --legacy --filter @tc/node-api --prod /out

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    PORT=80 \
    HOST=0.0.0.0 \
    API_BASE_PATH=/api
COPY --from=build /out .
EXPOSE 80
CMD ["node", "dist/server.js"]
